{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "estadliga-auth-local",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "estadliga_db",
      "database_name": "estadliga-auth-pruebas",
      "database_id": "00000000-0000-4000-8000-000000000001"
    }
  ],
  "r2_buckets": [
    {
      "binding": "estadliga_imagenes",
      "bucket_name": "estadliga-auth-pruebas"
    }
  ]
}
