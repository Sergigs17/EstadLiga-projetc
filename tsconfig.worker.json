{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "worker/**/*.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "worker/**/*.bak.ts",
    "worker/**/*.antes-*.ts"
  ]
}
