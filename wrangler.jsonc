
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estadliga",
  "account_id": "d5bca1c3b135282b34df42deba4cd0e6",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "estadliga_db",
      "database_name": "estadliga-db",
      "database_id": "bda15ce8-9259-43cb-aa05-2276a4dadb8c",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "estadliga-imagenes",
      "binding": "estadliga_imagenes",
      "remote": true
    }
  ]
}
